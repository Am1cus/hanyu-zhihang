  "components": {
    "schemas": {
      "ActionInput": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "pause",
              "resume",
              "cancel"
            ],
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "ActionInput"
      },
      "CreateInput": {
        "properties": {
          "preset": {
            "type": "string",
            "enum": [
              "normal",
              "obstacle",
              "gust",
              "low_budget",
              "unavailable",
              "blocked_return"
            ],
            "title": "Preset",
            "default": "obstacle"
          },
          "selector_id": {
            "type": "string",
            "enum": [
              "fixed_order",
              "nearest_feasible",
              "value_per_cost",
              "subset_dp"
            ],
            "title": "Selector Id",
            "default": "value_per_cost"
          },
          "temperature_c": {
            "type": "number",
            "maximum": 30.0,
            "minimum": -40.0,
            "title": "Temperature C",
            "default": 0.0
          },
          "initial_soc": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Initial Soc",
            "default": 0.85
          },
          "budget_mode": {
            "type": "string",
            "enum": [
              "nominal",
              "bounded"
            ],
            "title": "Budget Mode",
            "default": "bounded"
          },
          "speedup": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Speedup",
            "default": 20.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateInput"
      },
      "EventInput": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "obstacle_ahead",
              "gust",
              "both_gates"
            ],
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "EventInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
